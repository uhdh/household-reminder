# Neon Postgres 연결 문자열
DATABASE_URL=

# Auth.js (next-auth v5) — Google 로그인만 사용, JWT 세션(DB adapter 없음)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 가계부 접근을 허용할 이메일 목록(쉼표로 구분). 비어 있으면 아무도 로그인할 수 없다(fail-closed).
ALLOWED_EMAILS=

# 메일 가져오기: DB migration + Resend webhook 설정 완료 후 활성화
EMAIL_IMPORT_ENABLED=false
IMPORT_EMAIL_DOMAIN=iecrisiofl.resend.app
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
